rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 0. Global Safety Net
    match /{document=**} {
      allow read, write: if false;
    }

    // --- Helpers ---
    function isSignedIn() { return request.auth != null; }
    function isOwner(userId) { return isSignedIn() && request.auth.uid == userId; }
    function isValidId(id) { return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$'); }
    function incoming() { return request.resource.data; }
    function existing() { return resource.data; }

    // --- Entity Validations ---
    function isValidChat(data) {
      return data.keys().hasAll(['userId', 'title', 'createdAt', 'updatedAt'])
        && data.keys().size() == 4
        && data.userId is string && data.userId.size() <= 128
        && data.title is string && data.title.size() <= 500
        && data.createdAt == request.time
        && data.updatedAt == request.time;
    }

    function isValidMessage(data) {
      return data.keys().hasAll(['role', 'text', 'createdAt'])
        && data.keys().size() == 3
        && data.role in ['user', 'model']
        && data.text is string && data.text.size() <= 10000
        && data.createdAt == request.time;
    }

    // --- Collection Rules ---

    match /chats/{chatId} {
      allow create: if isSignedIn() 
        && isValidId(chatId)
        && isValidChat(incoming())
        && isOwner(incoming().userId);
        
      allow get: if isSignedIn() && isOwner(existing().userId);
      
      allow list: if isSignedIn() && resource.data.userId == request.auth.uid;

      allow update: if isSignedIn() && isOwner(existing().userId)
        && incoming().userId == existing().userId
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && incoming().title is string && incoming().title.size() <= 500
        && incoming().keys().hasAll(['userId', 'title', 'createdAt', 'updatedAt'])
        && incoming().keys().size() == 4;

      allow delete: if isSignedIn() && isOwner(existing().userId);

      match /messages/{messageId} {
        // Master Gate: Inherit from Chat
        function getChat() { return get(/databases/$(database)/documents/chats/$(chatId)).data; }
        
        allow create: if isSignedIn()
          && isValidId(messageId)
          && isOwner(getChat().userId)
          && isValidMessage(incoming());

        allow list: if isSignedIn() && isOwner(getChat().userId);
        allow get: if isSignedIn() && isOwner(getChat().userId);
      }
    }
  }
}
